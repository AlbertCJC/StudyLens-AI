{
  "expo": {
    "name": "StudyLens AI",
    "slug": "studylens-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f172a",
    "icon": "./assets/studylens-icon.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.studylens.mobile"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/studylens-icon.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-status-bar",
      ["expo-splash-screen", { "backgroundColor": "#0f172a" }]
    ]
  }
}
