{
  "name": "studylens-ai",
  "private": true,
  "version": "0.0.0",
  "description": "StudyLens AI monorepo orchestrator (backend/ Flask + frontend/ React web + mobile/ React Native)",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:web": "npm --prefix frontend run dev",
    "dev:api": "python backend/app.py",
    "backend": "python backend/app.py",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "start": "python backend/app.py",
    "reset:db": "python backend/scripts/reset_db.py --yes"
  }
}