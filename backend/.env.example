# ----------------------------------------------------
# StudyLens AI Environment Configuration
# ----------------------------------------------------

# Groq Inference AI API Key (GPT-OSS-120B via OpenAI-compatible API)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# JWT Authentication Secret Key
# REQUIRED. Generate a fresh random value per environment, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never reuse a committed default. The backend refuses to start without it.
JWT_SECRET=generate_a_unique_random_secret_here

# Demo data seeding (development only).
# The app NEVER seeds automatically. To provision demo accounts, set this to
# "true", set both demo passwords below, then run:
#   python backend/scripts/seed_dev.py
# Production refuses to start with this enabled.
SEED_DEMO_DATA=false

# Demo account passwords. REQUIRED only when SEED_DEMO_DATA=true.
# There are no built-in defaults. Use strong, unique values; known defaults and
# short passwords are rejected.
DEMO_TEACHER_PASSWORD=set-a-strong-unique-password
DEMO_ADMIN_PASSWORD=set-a-strong-unique-password

# Forgot-Password OTP delivery mode
# Never enable this outside local development. When true it returns one-time
# codes as `devCode` in API responses, which defeats 2FA and email verification.
OTP_DEV_REVEAL=false

# Deployment environment: development | production.
# Production disables demo seeding and OTP disclosure and fails fast on unsafe
# configuration.
FLASK_ENV=development

# Flask debug mode (Werkzeug debugger / auto-reload).
# The debugger on a public interface is a remote-code-execution vector, so this
# MUST stay "false" for any real (non-localhost-only) run.
FLASK_DEBUG=false

# Comma-separated list of origins allowed to call the API (CORS).
# Add your running frontend origin here (e.g. http://192.168.1.5:3000 for a LAN demo).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Maximum upload size in MB for course materials and AI attachments.
MAX_UPLOAD_MB=20

# MySQL Database Configuration
# Formats: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
MYSQL_DATABASE_URL=mysql+pymysql://root:password@localhost:3306/studylens_db
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword
MYSQL_DB=studylens_db

# Local-only escape hatch. When a configured MySQL target is unreachable this
# starts the app against SQLite instead. Never enable in production: the app
# fails fast on an unreachable MySQL target regardless of this flag.
ALLOW_SQLITE_FALLBACK=false

# Local-only escape hatch for cloud uploads. When a configured cloud target
# (Cloudinary / Firebase) fails, the app would otherwise silently fall back to
# the local uploads directory -- which is ephemeral and inaccessible across
# instances. Require an explicit opt-in; otherwise a cloud failure raises.
ALLOW_LOCAL_FALLBACK=false

# HttpOnly session cookie used by the web client (mobile uses bearer JWTs).
# Set AUTH_COOKIE_SECURE=true behind HTTPS. SameSite=Lax is fine when frontend
# and backend share a registrable domain; tighten to Strict if desired.
AUTH_COOKIE_NAME=studylens_session
AUTH_COOKIE_PATH=/
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax

# Double-submit CSRF cookie (non-HttpOnly so the SPA can read it) for cookie-authenticated writes.
CSRF_COOKIE_NAME=studylens_csrf

# Mobile apps must send X-Client-Type: mobile on /auth/* calls so the response
# still includes a bearer token body (secure storage on the device).
MOBILE_CLIENT_HEADER=X-Client-Type
MOBILE_CLIENT_VALUE=mobile

# Cloud Storage Configuration (for uploaded lecture notes & modules)
# Cloudinary (e.g., cloudinary://API_KEY:API_SECRET@CLOUD_NAME)
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Firebase Storage Credentials Path (Optional)
FIREBASE_CREDENTIALS=firebase-credentials.json
FIREBASE_STORAGE_BUCKET=studylens-ai.appspot.com

# Python Flask Server Port
FLASK_PORT=5000

# ----------------------------------------------------
# Gmail SMTP Email Delivery
# ----------------------------------------------------
# Delivery for all one-time codes (email verification, password reset, and
# staff 2FA) via Gmail SMTP (smtp.gmail.com:587 with STARTTLS).
#
# 1. Enable 2-Step Verification on the sending Gmail account:
#    https://myaccount.google.com/security
# 2. Create an App Password (16 characters):
#    https://myaccount.google.com/apppasswords
# 3. Put the Gmail address here and the App Password in GMAIL_APP_PASSWORD.
#    Paste the 16-character password WITHOUT spaces (Google displays it as
#    "xxxx xxxx xxxx xxxx"; the spaces are not part of the credential).
#
# Leave GMAIL_APP_PASSWORD empty to keep dev behavior: codes are surfaced
# through OTP_DEV_REVEAL / the backend console and are never emailed. Set it
# when you want codes emailed to any recipient address (recipients do NOT
# need a Google account).
GMAIL_SENDER=yourname@gmail.com
GMAIL_APP_PASSWORD=

# Optional SMTP overrides. Defaults target Gmail on port 587 with STARTTLS.
# If outbound port 587 is blocked (common on some networks/cloud hosts), set
# GMAIL_SMTP_PORT=465 and GMAIL_SMTP_USE_SSL=true.
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USE_SSL=false
GMAIL_SMTP_TIMEOUT=15
# Optional Reply-To address (defaults to none).
GMAIL_REPLY_TO=
#
# Verify delivery without registering an account:
#   python backend/scripts/test_email.py [recipient@example.com]
# Once email delivery is confirmed, set OTP_DEV_REVEAL=false so one-time codes
# are only delivered by email.
