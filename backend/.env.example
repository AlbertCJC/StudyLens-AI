# ----------------------------------------------------
# StudyLens AI Environment Configuration
# ----------------------------------------------------

# Groq Inference AI API Key (GPT-OSS-120B via OpenAI-compatible API)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# JWT Authentication Secret Key
# REQUIRED. Generate a fresh random value per environment, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never reuse a committed default. The backend refuses to start without it.
JWT_SECRET=generate_a_unique_random_secret_here

# Forgot-Password OTP delivery mode
# "true" (dev default) also returns the reset code as `devCode` in the API response
# so the web/mobile UI can display it without a mailer. Set to "false" in production
# and add a real email service.
OTP_DEV_REVEAL=true

# Flask debug mode (Werkzeug debugger / auto-reload).
# The debugger on a public interface is a remote-code-execution vector, so this
# MUST stay "false" for any real (non-localhost-only) run.
FLASK_DEBUG=false

# Comma-separated list of origins allowed to call the API (CORS).
# Add your running frontend origin here (e.g. http://192.168.1.5:3000 for a LAN demo).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Maximum upload size in MB for course materials and AI attachments.
MAX_UPLOAD_MB=20

# MySQL Database Configuration
# Formats: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
MYSQL_DATABASE_URL=mysql+pymysql://root:password@localhost:3306/studylens_db
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword
MYSQL_DB=studylens_db

# Cloud Storage Configuration (for uploaded lecture notes & modules)
# Cloudinary (e.g., cloudinary://API_KEY:API_SECRET@CLOUD_NAME)
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Firebase Storage Credentials Path (Optional)
FIREBASE_CREDENTIALS=firebase-credentials.json
FIREBASE_STORAGE_BUCKET=studylens-ai.appspot.com

# Python Flask Server Port
FLASK_PORT=5000
